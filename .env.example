# 相对 SQLite 路径固定以物理 Git 仓库根目录为基准，不受启动目录影响。
# 启动前会只读审计规范库与 backend/ 下的旧路径；零字节旧库仅警告，非空重复库会阻断。
DATABASE_URL=sqlite:///./trend_video_factory.db
CODEX_SKILLS_ROOT_DIR=D:/CodexData/.codex/skills

AI_PROVIDER=fake
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=fake-low-cost
AI_TIMEOUT=60
AI_MAX_RETRIES=2

EXPORT_DIR=D:/短视频工厂/exports
MATERIAL_ROOT_DIR=D:/短视频工厂
PROJECT_ROOT_DIR=D:/短视频工厂/项目
# Pexels/Pixabay Key 由真实素材执行链从此根目录下的“自动下载/<Provider>/API Key”读取。
AUTO_MATERIAL_ROOT_DIR=D:/素材
JIANYING_ADAPTER_TYPE=desktop
JIANYING_DESKTOP_APP_PATH=
JIANYING_DOWNLOAD_DIR=D:/短视频工厂/素材库/剪映下载
JIANYING_DESKTOP_UI_CONFIG_PATH=./config/jianying_ui_profile.yaml
MAX_CANDIDATES_PER_SEARCH=5
MIN_MATERIAL_SCORE=60
MAX_DOWNLOADS_PER_TASK=1
CANDIDATE_SCREENSHOT_DIR=素材信息/候选截图
JIANYING_LAUNCH_TIMEOUT_SECONDS=30
JIANYING_DOWNLOAD_TIMEOUT_SECONDS=120

AUTO_HOTSPOT_ON_STARTUP=false
AUTO_HOTSPOT_INTERVAL_HOURS=24
AUTO_HOTSPOT_MAX_TOPICS=8

BROWSER_HOTSPOT_PROFILE_DIR=./outputs/browser-profiles/hotspots
BROWSER_HOTSPOT_CSV_PATH=D:/短视频工厂/exports/热点采集/browser_hotspots.csv
BROWSER_HOTSPOT_HEADLESS=false
BROWSER_HOTSPOT_MAX_ITEMS=10

PIXABAY_MAX_CANDIDATES_PER_KEYWORD=10
COVERR_MAX_CANDIDATES_PER_KEYWORD=10

TTS_PROVIDER=windows_sapi
TTS_VOICE_NAME=
TTS_RATE=0
TTS_VOLUME=90
